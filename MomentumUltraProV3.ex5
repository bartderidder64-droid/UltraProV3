//+------------------------------------------------------------------+
//|  MOMENTUM AUTORISK ULTRA PRO V3.2                               |
//|  - Multi-market engine (indices, XAU, FX, OIL, ...)              |
//|  - Auto-Risk op basis van equity DD + Ultra Boost               |
//|  - EMA-trend, breakout, ATR-regime, RSI, body/wick filter        |
//|  - Volatility-adaptive trailing (ATR + EMA)                      |
//|  - PRO dashboard + debug panel                                   |
//|  - Custom OnTester ranking + CSV export                          |
//+------------------------------------------------------------------+
#property strict
#include <Trade/Trade.mqh>
CTrade trade;

//--- EA versie (pas dit aan bij ieder release)
#define EA_VERSION 3.10

//-------------------------------------------------------------------
// INPUTS - CORE
//-------------------------------------------------------------------
input ulong  InpMagicNumber        = 480000;
input bool   InpUseAutoMagic       = true;

input double InpRiskPercent        = 1.0;
input double InpMaxLongLots        = 5.0;
input double InpMaxShortLots       = 5.0;

input bool   InpOneTradePerBar     = true;
input bool   InpAllowLongs         = true;
input bool   InpAllowShorts        = true;

// ATR / basic volatility
input int    InpATRPeriod          = 12;
input double InpATRMultSL          = 1.2;
input double InpATRMultTP          = 3.0;
input bool   InpUseLowVolFilter    = true;
input double InpMinATRPercent      = 0.0002;

// ATR regime filter
input int    InpATRRegimePeriod    = 40;
input double InpATRLowFactor       = 0.8;
input double InpATRHighFactor      = 2.1;

// RSI momentum filter
input bool   InpUseRSIFilter       = true;
input int    InpRSILength          = 14;
input double InpRSIMinTrend        = 60.0;

// Trend EMAs
input bool   InpUseTrendFilter     = true;
input int    InpTrendFastPeriod    = 55;
input int    InpTrendSlowPeriod    = 130;

// Entry EMAs
input bool   InpUseEntryEMAFilter  = true;
input int    InpEntryFastPeriod    = 21;
input int    InpEntrySlowPeriod    = 55;

// Breakout / candle filters
input int    InpBreakoutLookback   = 18;
input double InpMinBodyPct         = 30.0;

// Session filter
input bool   InpUseSessionFilter   = true;
input int    InpSess1StartHour     = 8;
input int    InpSess1EndHour       = 12;
input int    InpSess2StartHour     = 14;
input int    InpSess2EndHour       = 21;

// Auto-Risk
input bool   InpUseAutoRisk        = true;
input double InpRiskBoostPercent   = 3.0;
input double InpRiskNormalPercent  = 1.5;
input double InpRiskMinPercent     = 0.5;
input double InpDD_Level1          = 0.5;
input double InpDD_Level2          = 1.5;
input double InpDD_StopLevel       = 3.0;

// Trailing
input bool   InpUseTrailing        = true;
input double InpTrail_BE_ATR       = 1.0;
input double InpTrail_ATR_Start    = 1.5;
input double InpTrail_ATR_Mult     = 2.0;

input double InpTrail_BE_OffsetATR = 0.2;
input double InpTrail_EMA_Start    = 2.5;
input bool   InpTrailUseTrendEMA   = true;

// TP automation (momenteel niet actief in logic, maar reserve)
input bool   InpUseTPAutomation    = false;
input double InpTP1_Ratio          = 1.0;
input double InpTP2_Ratio          = 2.0;
input double InpTP3_Ratio          = 3.0;
input double InpTP_Partial         = 0.25;

// UI / debug
input bool   InpShowDashboard      = true;
input bool   InpShowDebugPanel     = true;
input bool   InpDebug              = false;

//--- Auto-Update
input bool   InpUseAutoUpdate = false;    // true = versie online checken
input string InpUpdateURL     = "https://jouw-domein.com/UltraProV3/version.txt";

//-------------------------------------------------------------------
// ULTRA PRO V3.2 EXTENSIONS (6 upgrades)
//-------------------------------------------------------------------

// 1) Trend Acceleration
input double InpMinTrendDelta      = 0.00015;
input bool   InpUseRSIAcceleration = false;   // placeholder (niet agressief gebruikt)

// 2) ATR-normalized breakout
input double InpMinBreakoutATR     = 0.20;

// 3) Deep pullback validator
input bool   InpUseDeepPullback    = true;
input double InpPullMinBodyPct     = 35.0;
input double InpPullMaxWickPct     = 50.0;

// 4) Regime V2 (ATR fast/slow)
input int    InpATRFastPeriod      = 10;
input int    InpATRSlowPeriod      = 50;

// 5) Volatility-adaptive trailing
input double InpRegimeMultLow      = 1.40;
input double InpRegimeMultNormal   = 1.00;
input double InpRegimeMultHigh     = 0.70;

// 6) Dynamic Risk Ultra Boost
input double InpRiskUltraBoost     = 1.40;
input double InpDD_UltraLevel      = 0.40;

//-------------------------------------------------------------------
// GLOBALS
//-------------------------------------------------------------------
string   g_symbol  = "";
string   g_baseSymbol = "";
ulong    g_magic   = 0;

double   g_point      = 0.0;
double   g_tickValue  = 0.0;
double   g_tickSize   = 0.0;
double   g_minLot     = 0.0;
double   g_maxLot     = 0.0;
double   g_lotStep    = 0.0;

double   g_peakEquity       = 0.0;
double   g_currentDDPercent = 0.0;
datetime g_lastBarTime      = 0;

// indicator handles
int hATR           = INVALID_HANDLE;
int hRSI           = INVALID_HANDLE;
int hTrendFastEMA  = INVALID_HANDLE;
int hTrendSlowEMA  = INVALID_HANDLE;
int hEntryFastEMA  = INVALID_HANDLE;
int hEntrySlowEMA  = INVALID_HANDLE;

// runtime config (gevuld uit inputs)
int    cATRPeriod, cRSILength, cTrendFastPeriod, cTrendSlowPeriod;
int    cEntryFastPeriod, cEntrySlowPeriod, cBreakoutLookback;
double cATRMultSL, cATRMultTP, cMinATRPercent, cMinBodyPct;
bool   cUseLowVolFilter, cUseRSIFilter, cUseTrendFilter, cUseEntryEMAFilter;
int    cATRRegimePeriod;
double cATRLowFactor, cATRHighFactor;
double cRSIMinTrend;
bool   cUseSessionFilter;
int    cSess1StartHour, cSess1EndHour, cSess2StartHour, cSess2EndHour;
bool   cUseAutoRisk;
double cRiskBoostPercent, cRiskNormalPercent, cRiskMinPercent;
double cDD_Level1, cDD_Level2, cDD_StopLevel;

// Ultra Pro runtime config
double cMinTrendDelta;
bool   cUseRSIAcceleration;
double cMinBreakoutATR;

bool   cUseDeepPullback;
double cPullMinBodyPct;
double cPullMaxWickPct;

int    cATRFastPeriod;
int    cATRSlowPeriod;

double cRegimeMultLow;
double cRegimeMultNormal;
double cRegimeMultHigh;

double cRiskUltraBoost;
double cDD_UltraLevel;

// Optimizer globals
int    g_optFileHandle = INVALID_HANDLE;
double g_bestScore     = -DBL_MAX;

//--- Auto-Update state
double g_remoteVersion   = 0.0;
bool   g_updateAvailable = false;
string g_updateInfo      = "";

//-------------------------------------------------------------------
// Helper structs
//-------------------------------------------------------------------
struct UltraInd
{
   double atr;
   double rsi;
   double trendFast;
   double trendSlow;
   double entryFast;
   double entrySlow;
};

//+------------------------------------------------------------------+
//| Base symbol (strip suffix)                                       |
//+------------------------------------------------------------------+
string BaseSymbol(string sym)
{
   int n = StringLen(sym);
   for(int i=0;i<n;i++)
   {
      int c = StringGetCharacter(sym,i);
      bool ok = (c>='A'&&c<='Z')||(c>='a'&&c<='z')||(c>='0'&&c<='9');
      if(!ok)
         return StringSubstr(sym,0,i);
   }
   return sym;
}

//+------------------------------------------------------------------+
//| Auto Magic Number                                                |
//+------------------------------------------------------------------+
ulong AutoMagic(const string base)
{
   int n = StringLen(base);
   string num = "";
   for(int i=n-1;i>=0;i--)
   {
      int c = StringGetCharacter(base,i);
      if(c>='0' && c<='9')
         num = (string)StringSubstr(base,i,1) + num;
      else
         break;
   }
   if(StringLen(num)>0)
      return 480000 + (ulong)StringToInteger(num);

   int h=0;
   for(int i=0;i<n;i++)
      h = (h*31 + StringGetCharacter(base,i)) & 0x7FFFFFFF;

   return 480000 + (ulong)(h % 100000);
}

//+------------------------------------------------------------------+
//| WebRequest helper - download text (bv. versie)                   |
//+------------------------------------------------------------------+
bool DownloadText(const string url, string &outText)
{
   outText = "";
   char data[];      // geen POST data
   char result[];    // hier komt HTTP-body in
   string headers = "";

   int res = WebRequest("GET",
                        url,
                        "",
                        5000,
                        data,
                        result,
                        headers);

   if(res != 200)
   {
      Print("AutoUpdate: WebRequest failed. Code=", res, " URL=", url);
      return false;
   }

   if(ArraySize(result) <= 0)
   {
      Print("AutoUpdate: leeg antwoord van server.");
      return false;
   }

   outText = CharArrayToString(result, 0, -1, CP_UTF8);
   StringTrimLeft(outText);
   StringTrimRight(outText);
   return (StringLen(outText) > 0);
}

//+------------------------------------------------------------------+
//| CheckForUpdate - vergelijkt EA_VERSION met remote versie         |
//+------------------------------------------------------------------+
void CheckForUpdate()
{
   g_updateAvailable = false;
   g_remoteVersion   = 0.0;
   g_updateInfo      = "";

   if(!InpUseAutoUpdate)
      return;

   if(StringLen(InpUpdateURL) < 10)
   {
      Print("AutoUpdate: InpUpdateURL niet ingesteld.");
      return;
   }

   string txt;
   if(!DownloadText(InpUpdateURL, txt))
   {
      g_updateInfo = "Update check failed";
      return;
   }

   // Verwacht tekst als bv: 3.20 of "3.20\n"
   double remote = StringToDouble(txt);
   if(remote <= 0.0)
   {
      Print("AutoUpdate: kon remote versie niet parsen uit: ", txt);
      g_updateInfo = "Update parse error";
      return;
   }

   g_remoteVersion = remote;

   if(remote > EA_VERSION)
   {
      g_updateAvailable = true;
      g_updateInfo = "Nieuwe versie v" + DoubleToString(remote,2) +
                     " beschikbaar (huidig v" + DoubleToString(EA_VERSION,2) + ")";
      Print("AutoUpdate: ", g_updateInfo);
   }
   else
   {
      g_updateInfo = "Up-to-date (v" + DoubleToString(EA_VERSION,2) + ")";
      Print("AutoUpdate: EA is up-to-date. Local=", DoubleToString(EA_VERSION,2),
            " Remote=", DoubleToString(remote,2));
   }
}


//+------------------------------------------------------------------+
//| LoadConfig from inputs                                           |
//+------------------------------------------------------------------+
void LoadConfig()
{
   cATRPeriod        = InpATRPeriod;
   cATRMultSL        = InpATRMultSL;
   cATRMultTP        = InpATRMultTP;
   cUseLowVolFilter  = InpUseLowVolFilter;
   cMinATRPercent    = InpMinATRPercent;

   cATRRegimePeriod  = InpATRRegimePeriod;
   cATRLowFactor     = InpATRLowFactor;
   cATRHighFactor    = InpATRHighFactor;

   cUseRSIFilter     = InpUseRSIFilter;
   cRSILength        = InpRSILength;
   cRSIMinTrend      = InpRSIMinTrend;

   cUseTrendFilter   = InpUseTrendFilter;
   cTrendFastPeriod  = InpTrendFastPeriod;
   cTrendSlowPeriod  = InpTrendSlowPeriod;

   cUseEntryEMAFilter = InpUseEntryEMAFilter;
   cEntryFastPeriod   = InpEntryFastPeriod;
   cEntrySlowPeriod   = InpEntrySlowPeriod;

   cBreakoutLookback = InpBreakoutLookback;
   cMinBodyPct       = InpMinBodyPct;

   cUseSessionFilter = InpUseSessionFilter;
   cSess1StartHour   = InpSess1StartHour;
   cSess1EndHour     = InpSess1EndHour;
   cSess2StartHour   = InpSess2StartHour;
   cSess2EndHour     = InpSess2EndHour;

   cUseAutoRisk      = InpUseAutoRisk;
   cRiskBoostPercent = InpRiskBoostPercent;
   cRiskNormalPercent= InpRiskNormalPercent;
   cRiskMinPercent   = InpRiskMinPercent;
   cDD_Level1        = InpDD_Level1;
   cDD_Level2        = InpDD_Level2;
   cDD_StopLevel     = InpDD_StopLevel;

   // Ultra Pro
   cMinTrendDelta      = InpMinTrendDelta;
   cUseRSIAcceleration = InpUseRSIAcceleration;
   cMinBreakoutATR     = InpMinBreakoutATR;

   cUseDeepPullback    = InpUseDeepPullback;
   cPullMinBodyPct     = InpPullMinBodyPct;
   cPullMaxWickPct     = InpPullMaxWickPct;

   cATRFastPeriod      = InpATRFastPeriod;
   cATRSlowPeriod      = InpATRSlowPeriod;

   cRegimeMultLow      = InpRegimeMultLow;
   cRegimeMultNormal   = InpRegimeMultNormal;
   cRegimeMultHigh     = InpRegimeMultHigh;

